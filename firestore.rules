rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Properties collection
    match /properties/{propertyId} {
      // Public can read published properties
      allow read: if resource.data.published == true || (isAuthenticated() && request.auth.uid == resource.data.ownerId);
      
      // Only authenticated property owner can create, update or delete
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isResourceOwner();
    }

    // 3. Leads collection
    match /leads/{leadId} {
      // Public can submit a lead inquiry form
      allow create: if request.resource.data.name != null 
                    && request.resource.data.email != null 
                    && request.resource.data.propertyId != null
                    && request.resource.data.consent == true;

      // Only the agent/owner can read, update, score or delete their leads
      allow read, update, delete: if isResourceOwner();
    }

    // 4. Generated Content collection
    match /generatedContent/{contentId} {
      allow read, write: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }
  }
}
